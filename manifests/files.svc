# SPDX-License-Identifier: Apache-2.0
name        = files
binary      = /system/apps/files
description = Your home: its folders and files, moved, renamed, and the bin.
start       = demand
after       = logger, stage
restart     = on-failure
class       = interactive
grants      = fonts
# Storage in every flavour from the tester build (TASK-114): a release build's devmgr gives drv-nvme a virtual machine's controller only.
flavours    = release, dev, e2e
