# SPDX-License-Identifier: Apache-2.0
name        = files
binary      = /system/apps/files
description = Your home: its folders and files, moved, renamed, and the bin.
start       = demand
after       = logger, stage
restart     = on-failure
class       = interactive
grants      = fonts
# Storage is QEMU-only in Phase 6: dev and e2e images.
flavours    = dev, e2e
