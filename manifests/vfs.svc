# SPDX-License-Identifier: Apache-2.0
name        = vfs
binary      = /system/services/vfs
description = Gives every app one tree of folders: the system's, read-only, and your home, yours alone.
start       = boot
after       = logger, ffs
restart     = on-failure
class       = background
# Storage in every flavour from the tester build (TASK-114): a release build's devmgr gives drv-nvme a virtual machine's controller only.
flavours    = release, dev, e2e
