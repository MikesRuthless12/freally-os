# SPDX-License-Identifier: Apache-2.0
name        = vfs
binary      = /system/services/vfs
description = Gives every app one tree of folders: the system's, read-only, and your home, yours alone.
start       = boot
after       = logger, ffs
restart     = on-failure
class       = background
# Storage is QEMU-only in Phase 6: dev and e2e images.
flavours    = dev, e2e
