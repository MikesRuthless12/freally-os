# SPDX-License-Identifier: Apache-2.0
name        = login
binary      = /system/apps/login
description = Opens an account with its password; shuts down or restarts the computer.
start       = demand
after       = logger, stage, accounts
restart     = on-failure
class       = interactive
grants      = fonts, os
# Storage in every flavour from the tester build (TASK-114): a release build's devmgr gives drv-nvme a virtual machine's controller only.
flavours    = release, dev, e2e
