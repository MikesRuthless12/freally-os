# SPDX-License-Identifier: Apache-2.0
name        = welcome
binary      = /system/apps/welcome
description = Makes the first account on a new disk: the Owner of this computer.
start       = demand
after       = logger, stage, accounts
restart     = on-failure
class       = interactive
grants      = fonts
# Storage in every flavour from the tester build (TASK-114): a release build's devmgr gives drv-nvme a virtual machine's controller only.
flavours    = release, dev, e2e
