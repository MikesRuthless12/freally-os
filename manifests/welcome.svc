# SPDX-License-Identifier: Apache-2.0
name        = welcome
binary      = /system/apps/welcome
description = Makes the first account on a new disk: the Owner of this computer.
start       = demand
after       = logger, stage, accounts
restart     = on-failure
class       = interactive
grants      = fonts
# Accounts need storage: QEMU-only in Phase 6, dev and e2e images.
flavours    = dev, e2e
