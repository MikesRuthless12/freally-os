# SPDX-License-Identifier: Apache-2.0
name        = accounts
binary      = /system/services/accounts
description = Checks your password, opens your home while you're logged in, and forgets its key when you log out.
start       = boot
after       = logger, vfs, ffs
restart     = on-failure
class       = background
# Storage in every flavour from the tester build (TASK-114): a release build's devmgr gives drv-nvme a virtual machine's controller only.
flavours    = release, dev, e2e
