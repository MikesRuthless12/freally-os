# SPDX-License-Identifier: Apache-2.0
name        = ffs
binary      = /system/services/ffs
description = Keeps your files on the disk: FreallyFS, every change whole or not at all, each home sealed with its owner's key.
start       = boot
after       = logger, drv-nvme
restart     = on-failure
class       = background
# Storage in every flavour from the tester build (TASK-114): a release build's devmgr gives drv-nvme a virtual machine's controller only.
flavours    = release, dev, e2e
