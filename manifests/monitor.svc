# SPDX-License-Identifier: Apache-2.0
name        = monitor
binary      = /system/apps/monitor
description = Shows every process, how the boot went, what crashed, the log, and every device.
start       = demand
after       = logger, stage, devmgr
restart     = on-failure
class       = interactive
grants      = fonts
flavours    = release, dev, e2e
