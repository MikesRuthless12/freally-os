# SPDX-License-Identifier: Apache-2.0
name        = settings
binary      = /system/apps/settings
description = Your look (theme, background, scale, motion, clock, screensaver), your account, and this machine.
start       = demand
after       = logger, stage, devmgr
restart     = on-failure
class       = interactive
grants      = fonts, os
flavours    = release, dev, e2e
