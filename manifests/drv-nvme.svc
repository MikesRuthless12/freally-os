# SPDX-License-Identifier: Apache-2.0
name        = drv-nvme
binary      = /system/drivers/nvme
description = Reads and writes the NVMe drive, and writes only inside Freally OS's own partitions.
start       = boot
after       = logger, devmgr
restart     = on-failure
class       = background
grants      = dma
# Storage in every flavour from the tester build (TASK-114): a release build's devmgr gives drv-nvme a virtual machine's controller only.
flavours    = release, dev, e2e
